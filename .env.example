# Example environment variables for running the server locally
# Copy this file to .env.local and fill values (or run the helper script to auto-fill with Ethereal)

# SMTP configuration (required for contact form email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass

# Optional: override recipient for contact form
CONTACT_TO=salvatorestroomup@gmail.com

# Other example variables
PING_MESSAGE=dev-ping
